# Fabric CA bootstrap identities
CA_ORDERER_BOOTSTRAP_USER=admin
CA_ORDERER_BOOTSTRAP_PASSWORD=change-me
CA_VARA_BOOTSTRAP_USER=admin
CA_VARA_BOOTSTRAP_PASSWORD=change-me
CA_SAHAJ_BOOTSTRAP_USER=admin
CA_SAHAJ_BOOTSTRAP_PASSWORD=change-me

# CouchDB backing the peers
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me

# Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Explorer database
EXPLORER_DB_NAME=fabricexplorer
EXPLORER_DB_USER=hppoc
EXPLORER_DB_PASSWORD=change-me

# Explorer logging
EXPLORER_LOG_LEVEL_APP=info
EXPLORER_LOG_LEVEL_DB=info
EXPLORER_LOG_LEVEL_CONSOLE=info

# Container logging
CONTAINER_LOG_MAX_SIZE=50m
CONTAINER_LOG_MAX_FILES=5

# Optional platform toggles used by scripts/bootstrap.sh
ENABLE_CA=false
ENABLE_MONITORING=false
ENABLE_EXPLORER=false
